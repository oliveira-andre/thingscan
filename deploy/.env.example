# The domain whose DNS A (and AAAA) record points at this VPS. Caddy gets its HTTPS
# certificate from Let's Encrypt, which needs ports 80 and 443 open.
THINGSCAN_DOMAIN=sync.example.com

# Turn this off once your account (and your family's) exists, so nobody else can sign up.
THINGSCAN_ALLOW_SIGNUP=true
