{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the menu bar panel",
  "windows": [
    "main",
    "tray"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "core:window:allow-hide"
  ]
}
