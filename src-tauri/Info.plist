<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Thingscan listens for Bluetooth adverts to find devices nearby and to check that added devices are still around.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Thingscan looks for devices on your local network and checks that added devices still answer.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_smartthings._tcp</string>
    <string>_smartthings-hedge._tcp</string>
    <string>_matterc._udp</string>
    <string>_matterd._udp</string>
    <string>_matter._tcp</string>
    <string>_meshcop._udp</string>
  </array>
</dict>
</plist>
